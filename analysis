    <!-- Floating Back to Top Button -->
    <button id="floatingBackToTop" class="floating-top-btn" aria-label="Scroll Back To Top">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxWA7gkFJqPCGwif7k241UruSBjXg8XFmkAUkRhfTVQPuB4Wttnh-cyLANH41V06MvB/exec";
        const CACHE_KEY = "tocawi_17_vaccination_visuals_cache_v1";

        let allRecords = [];
        let statusPieChart, coveragePieChart, countyBarChart, areaBarChart;

        document.addEventListener('DOMContentLoaded', function() {
            const siteHeader = document.getElementById('siteHeader');
            const menuToggle = document.getElementById('menuToggle');
            const mobileNav = document.getElementById('mobileNav');
            const menuClose = document.getElementById('menuClose');
            const mobileLinks = mobileNav.querySelectorAll('.mobile-link');
            const scrollTopBtn = document.getElementById('floatingBackToTop');

            function updateHeaderOnScroll() {
                if (window.scrollY > 24) {
                    siteHeader.classList.add('is-scrolled');
                } else {
                    siteHeader.classList.remove('is-scrolled');
                }
            }

            function closeMobileMenu() {
                mobileNav.classList.remove('is-active');
                document.body.style.overflow = '';
            }

            menuToggle.addEventListener('click', function() {
                mobileNav.classList.add('is-active');
                document.body.style.overflow = 'hidden';
            });

            menuClose.addEventListener('click', closeMobileMenu);
            mobileLinks.forEach(link => link.addEventListener('click', closeMobileMenu));

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') closeMobileMenu();
            });

            window.addEventListener('resize', function() {
                if (window.innerWidth > 768) closeMobileMenu();
            });

            window.addEventListener('scroll', function() {
                updateHeaderOnScroll();
                if (window.scrollY > 400) {
                    scrollTopBtn.classList.add('visible');
                } else {
                    scrollTopBtn.classList.remove('visible');
                }
            }, { passive: true });

            scrollTopBtn.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            updateHeaderOnScroll();
        });

        function normalizeStatus(rawStatus) {
            const s = String(rawStatus || '').trim().toLowerCase();
            if (s === 'vaccinated' || s === 'immunized' || s === 'done') return 'Vaccinated';
            if (s === 'booster due' || s === 'booster') return 'Booster Due';
            if (s === 'deferred') return 'Deferred';
            if (s === 'pending') return 'Pending';
            return 'Pending';
        }

        function normalizeRecords(rawList) {
            if (!Array.isArray(rawList)) return [];
            return rawList.map(item => ({
                county: String(item.county || item.County || 'Unspecified').trim() || 'Unspecified',
                subcounty: String(item.subcounty || item.Subcounty || '').trim(),
                ward: String(item.ward || item.Ward || '').trim(),
                location: String(item.location || item.Location || '').trim(),
                dogName: String(item.dogName || item.PetName || '').trim(),
                ownerName: String(item.ownerName || '').trim(),
                certificateNo: String(item.certificateNo || item.PUID || '').trim(),
                vaccinationStatus: normalizeStatus(item.vaccinationStatus || item.status)
            }));
        }

        function populateCountyOptions() {
            const selectEl = document.getElementById('countyFilter');
            const currentVal = selectEl.value;
            const counties = Array.from(new Set(allRecords.map(r => r.county).filter(Boolean))).sort();

            selectEl.replaceChildren(new Option('All Counties', '__ALL__'));
            counties.forEach(c => selectEl.add(new Option(c, c)));

            if (currentVal && Array.from(selectEl.options).some(o => o.value === currentVal)) {
                selectEl.value = currentVal;
            } else {
                selectEl.value = '__ALL__';
            }
        }

        function getFilteredRecords() {
            const selectedCounty = document.getElementById('countyFilter').value;
            const query = document.getElementById('keywordFilter').value.trim().toLowerCase();

            return allRecords.filter(r => {
                const matchesCounty = !selectedCounty || selectedCounty === '__ALL__' ||
                    r.county.toLowerCase() === selectedCounty.toLowerCase();
                const matchesQuery = !query || [
                    r.county, r.subcounty, r.ward, r.location,
                    r.dogName, r.ownerName, r.certificateNo, r.vaccinationStatus
                ].some(val => (val || '').toLowerCase().includes(query));
                return matchesCounty && matchesQuery;
            });
        }

        function renderAllVisuals() {
            const rows = getFilteredRecords();
            const selectedCounty = document.getElementById('countyFilter').value;
            const scopeLabel = (!selectedCounty || selectedCounty === '__ALL__')
                ? 'All Counties'
                : `${selectedCounty} County`;

            const total = rows.length;
            const vaccinated = rows.filter(r => r.vaccinationStatus === 'Vaccinated').length;
            const pending = rows.filter(r => r.vaccinationStatus === 'Pending').length;
            const boosterDue = rows.filter(r => r.vaccinationStatus === 'Booster Due').length;
            const deferred = rows.filter(r => r.vaccinationStatus === 'Deferred').length;
            const pendingOrBooster = pending + boosterDue;
            const notVaccinated = total - vaccinated;
            const coveragePct = total > 0 ? Math.round((vaccinated / total) * 100) : 0;

            // Update Numbers
            document.getElementById('heroTitle').textContent = `Rabies Vaccination Numbers & Visual Analytics — ${scopeLabel}`;
            document.getElementById('numScopeNote').textContent = `Filtered view: ${scopeLabel}`;
            document.getElementById('numTotalAnimals').textContent = total;
            document.getElementById('numVaccinated').textContent = vaccinated;
            document.getElementById('numPendingBooster').textContent = pendingOrBooster;
            document.getElementById('numDeferred').textContent = deferred;
            document.getElementById('numCoverage').textContent = `${coveragePct}%`;

            // Pie Chart 1: Vaccination Status Breakdown
            const ctxStatusPie = document.getElementById('statusPieChart').getContext('2d');
            if (statusPieChart) statusPieChart.destroy();
            statusPieChart = new Chart(ctxStatusPie, {
                type: 'pie',
                data: {
                    labels: ['Vaccinated', 'Pending', 'Booster Due', 'Deferred'],
                    datasets: [{
                        data: [vaccinated, pending, boosterDue, deferred],
                        backgroundColor: ['#457a00', '#f59e0b', '#3a5cbf', '#dc2626'],
                        borderColor: '#ffffff',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { color: '#333333', font: { family: 'Inter', weight: '600' } } }
                    }
                }
            });

            // Pie Chart 2: Vaccinated vs Not Vaccinated
            const ctxCoveragePie = document.getElementById('coveragePieChart').getContext('2d');
            if (coveragePieChart) coveragePieChart.destroy();
            coveragePieChart = new Chart(ctxCoveragePie, {
                type: 'pie',
                data: {
                    labels: ['Vaccinated', 'Pending / Booster / Deferred'],
                    datasets: [{
                        data: [vaccinated, notVaccinated],
                        backgroundColor: ['#3a5cbf', '#e07a41'],
                        borderColor: '#ffffff',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { color: '#333333', font: { family: 'Inter', weight: '600' } } }
                    }
                }
            });

            // Bar Chart 1: Vaccinated Count by County
            const countyCounts = {};
            rows.filter(r => r.vaccinationStatus === 'Vaccinated').forEach(r => {
                const key = r.county || 'Unspecified';
                countyCounts[key] = (countyCounts[key] || 0) + 1;
            });
            const countyLabels = Object.keys(countyCounts).sort((a, b) => countyCounts[b] - countyCounts[a]);
            const countyValues = countyLabels.map(k => countyCounts[k]);

            const ctxCountyBar = document.getElementById('countyBarChart').getContext('2d');
            if (countyBarChart) countyBarChart.destroy();
            countyBarChart = new Chart(ctxCountyBar, {
                type: 'bar',
                data: {
                    labels: countyLabels,
                    datasets: [{
                        label: 'Vaccinated Animals',
                        data: countyValues,
                        backgroundColor: '#3a5cbf',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { ticks: { color: '#4a4a4a', font: { family: 'Inter' } }, grid: { color: '#e2e8f0' } },
                        y: { beginAtZero: true, ticks: { color: '#4a4a4a', precision: 0, font: { family: 'Inter' } }, grid: { color: '#e2e8f0' } }
                    }
                }
            });

            // Bar Chart 2: Vaccinated Count by Sub-County / Ward
            const areaCounts = {};
            rows.filter(r => r.vaccinationStatus === 'Vaccinated').forEach(r => {
                const areaName = r.subcounty || r.ward || 'Unspecified Area';
                areaCounts[areaName] = (areaCounts[areaName] || 0) + 1;
            });
            const areaLabels = Object.keys(areaCounts).sort((a, b) => areaCounts[b] - areaCounts[a]).slice(0, 12);
            const areaValues = areaLabels.map(k => areaCounts[k]);

            const ctxAreaBar = document.getElementById('areaBarChart').getContext('2d');
            if (areaBarChart) areaBarChart.destroy();
            areaBarChart = new Chart(ctxAreaBar, {
                type: 'bar',
                data: {
                    labels: areaLabels,
                    datasets: [{
                        label: 'Vaccinated Animals',
                        data: areaValues,
                        backgroundColor: '#457a00',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { ticks: { color: '#4a4a4a', font: { family: 'Inter' } }, grid: { color: '#e2e8f0' } },
                        y: { beginAtZero: true, ticks: { color: '#4a4a4a', precision: 0, font: { family: 'Inter' } }, grid: { color: '#e2e8f0' } }
                    }
                }
            });
        }

        function fetchVaccinationData() {
            document.getElementById('syncStatus').textContent = 'Syncing Sheets DB...';
            fetch(SCRIPT_URL)
                .then(res => res.json())
                .then(payload => {
                    const rawRows = Array.isArray(payload.records)
                        ? payload.records
                        : (Array.isArray(payload.data) ? payload.data : []);
                    allRecords = normalizeRecords(rawRows);
                    localStorage.setItem(CACHE_KEY, JSON.stringify(allRecords));

                    document.getElementById('syncStatus').textContent = `Sheets DB Synced (${allRecords.length})`;
                    document.getElementById('loadingBanner').style.display = 'none';
                    populateCountyOptions();
                    renderAllVisuals();
                })
                .catch(err => {
                    console.error('Error fetching from Sheets DB:', err);
                    const cached = JSON.parse(localStorage.getItem(CACHE_KEY) || '[]');
                    allRecords = normalizeRecords(cached);
                    document.getElementById('syncStatus').textContent = `Cached Data (${allRecords.length})`;
                    document.getElementById('loadingBanner').style.display = 'none';
                    populateCountyOptions();
                    renderAllVisuals();
                });
        }

        fetchVaccinationData();
    </script>
</body>
